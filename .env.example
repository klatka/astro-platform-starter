# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.

# ── Optional: forward form submissions to an external webhook ─────────────────
# WEBHOOK_URL=https://hooks.example.com/your-endpoint

# ── Resend (email) ────────────────────────────────────────────────────────────
# Create a free account at https://resend.com, then go to API Keys and copy
# the key.  Leave this blank to use the Ethereal test transport in local dev.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "From" address shown in the confirmation email.
# Must belong to a domain you have verified in Resend.
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in your Supabase project: Settings → API
# SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key – safe to expose in client bundles but not required here
# because all Supabase calls happen server-side.
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-role key – keeps Row-Level Security from blocking server-side inserts.
# Never expose this in client-side code.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
